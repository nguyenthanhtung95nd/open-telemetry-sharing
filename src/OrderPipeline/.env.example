# This file is optional.
#
# docker-compose.yml already defaults every connection string to the `postgres`
# service it starts for you, so `docker compose up` works on a fresh copy with no
# .env at all. Copy this file to .env only when you want the services to use a
# Postgres of your own instead.
#
# Each service owns its own database, which is why there are three. Point them at
# a server that already has those three databases, because the migrator creates
# tables but not databases.

# ORDERPIPELINE_DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=orderpipelinedb;Username=YOUR_USER;Password=YOUR_PASSWORD
# INVENTORY_DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=inventorydb;Username=YOUR_USER;Password=YOUR_PASSWORD
# PAYMENT_DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=paymentdb;Username=YOUR_USER;Password=YOUR_PASSWORD

# The bundled postgres still starts even when the connection strings point
# elsewhere, and it publishes 5432 on this machine. Set this when your own
# Postgres already holds that port, otherwise the stack cannot start.
# POSTGRES_PORT=5433
